default_platform(:ios)

# PhotoCraft for iPadOS — signing and App Store Connect.
#
# Rust details that differ from the Flutter/XcodeGen projects in the other repos:
#   * the Rust static library must be built *before* Xcode links the app, so the lane runs
#     `cargo build … --target aarch64-apple-ios` first;
#   * the Xcode project is generated by XcodeGen (`ios/project.yml`) into `ios/`.
#
# Requires these GitHub Actions secrets (Settings → Secrets and variables → Actions):
#   APP_ID                          ai.storyteller.photocraft
#   TEAM_ID                         your Apple Developer team id
#   APPLE_KEY_ID / APPLE_ISSUER_ID / APPLE_KEY_CONTENT
#                                   App Store Connect API key (.p8, base64 in APPLE_KEY_CONTENT)
#   MATCH_REPOSITORY                https://github.com/andrewfblack/match-signing.git
#   MATCH_PASSWORD                  the match repo's encryption passphrase
#   MATCH_GIT_BASIC_AUTHORIZATION   base64("x-access-token:<GitHub PAT with repo scope>")

APP_IDENTIFIER = ENV.fetch("APP_ID", "ai.storyteller.photocraft")
MATCH_REPOSITORY = ENV.fetch("MATCH_REPOSITORY", "https://github.com/andrewfblack/match-signing.git")

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  lane :push_to_testflight do
    %w[TEAM_ID APPLE_KEY_ID APPLE_ISSUER_ID APPLE_KEY_CONTENT MATCH_PASSWORD].each do |key|
      UI.user_error!("Missing GitHub Actions secret: #{key}") if ENV[key].nil? || ENV[key].strip.empty?
    end

    basic_auth = ENV["MATCH_GIT_BASIC_AUTHORIZATION"].to_s.gsub(/\s+/, "")

    # A temporary keychain with a known password, so `codesign` grants access without an
    # interactive macOS permission prompt on the CI runner.
    setup_ci(timeout: 3600) if ENV["CI"] == "true"

    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_KEY_ID"],
      issuer_id: ENV["APPLE_ISSUER_ID"],
      key_content: ENV["APPLE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Certificates and provisioning profiles from the encrypted match repo. `readonly: false`
    # means the first run creates a distribution certificate and the App Store profile for
    # `APP_ID` (the App ID and the App Store Connect app record must already exist).
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      git_url: MATCH_REPOSITORY,
      api_key: api_key,
      readonly: false,
      force: false,
      git_basic_authorization: basic_auth.empty? ? nil : basic_auth
    )

    latest_build = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      initial_build_number: 0
    )
    next_build = latest_build + 1

    # Build the Rust library and the Xcode project before Xcode links and archives the app.
    sh("cargo build --release -p photocraft-ios --target aarch64-apple-ios")
    sh("cd ios && xcodegen generate")

    # Force manual signing with the profile match just installed (the XcodeGen project uses
    # automatic signing by default).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/PhotoCraft.xcodeproj",
      team_id: ENV["TEAM_ID"],
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{APP_IDENTIFIER}"
    )

    gym(
      project: "ios/PhotoCraft.xcodeproj",
      scheme: "PhotoCraft",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "PhotoCraft",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=#{ENV['TEAM_ID']} CURRENT_PROJECT_VERSION=#{next_build}",
      export_team_id: ENV["TEAM_ID"],
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "CI build #{next_build} from #{git_branch}"
    )
  end
end
